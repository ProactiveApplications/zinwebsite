---
const pageTitle = 'Attributions';
import Layout from '../../layouts/InnerPageLayout.astro';
---
<Layout pageTitle={pageTitle}>

    <section>

        <div class="container-fluid">
            
            <div class="container">

                <div class="grid">
                    <div class="col-12 col-mobile-12 mt-5 mb-3">
                        <a href="/legals">&#8592; Back to Legal Pages</a>
                    </div>
                </div>


                <div class="grid">
                    <div class="col-12 col-mobile-12 mt-5 mb-3">
                        <h1>Image Attributions</h1>
                        <hr />

                       <p class="mt-3">
                            We would like to express our gratitude to the following sources of images used in this website. 
                        </p>

                        <ul class="no-bullets mt-4">

                            <li class="list-group-item mb-3">
                                <strong>Images of female in blue sweater on home page</strong> 
                                <a href="https://www.pexels.com/@karola-g/" target="_blank" class="text-decoration-none">
                                    Kaboom Pics on Pexels
                                </a>    
                            </li>

                             <li class="list-group-item mb-3">
                                <strong>Image of library on home page</strong> 
                                <a href="https://www.pexels.com/@mehmetakifarts/" target="_blank" class="text-decoration-none">
                                    mehmetakifarts
                                </a>    
                            </li>

                        </ul>

                    </div>  
                </div>
            </div>
        </div>
    </section>
</Layout>