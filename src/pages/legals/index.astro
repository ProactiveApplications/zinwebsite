            <div class="col-mobile-12 col-6">
            
                    <article class="legal-row">
                        <a href="/legals/terms-and-conditions/" class="legal-link">
                            Terms and Conditions <span>&rarr;</span>
                        </a>
                    </article>
                
                    <article class="legal-row">
                        <a href="/legals/privacy-and-cookies/" class="legal-link">
                            Privacy and Cookies <span>&rarr;</span>
                        </a>
                    </article>
                    
                    <article class="legal-row">
                        <a href="/legals/attributions/" class="legal-link">
                            Attributions <span>&rarr;</span>
