        </article>

        <article class="zin-legal-item">
            <a href="/legals/privacy-and-cookies/" class="zin-legal-link">
                <span>Privacy and Cookies</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </article>

        <article class="zin-legal-item">
            <a href="/legals/attributions/" class="zin-legal-link">
                <span>Attributions</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </article>

    </div>

</Layout>