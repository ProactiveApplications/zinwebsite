---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
    const allBlogPosts = await getCollection('posts');
    
    return allBlogPosts.map((post) => ({
        params: { slug: post.data.slug },
        props: { entryId: post.id },
    }));
}

const { entryId } = Astro.props;
const post = await getEntry('posts', entryId);

if (!post) {
    return Astro.redirect('/404');
}

import Layout from '../../layouts/InnerPageLayout.astro';
import Backlink from '../../components/website/backlink.astro';
import CtaRow from '../../components/website/cta-row.astro';

const canonicalUrl = new URL(`/blog/${post.data.slug}/`, Astro.site).href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "datePublished": post.data.date.toISOString(),
  "mainEntityOfPage": canonicalUrl,
  "author": {
    "@type": "Person",
    "name": "Tony Radford",
    "url": "https://tonyradford.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Tony Radford"
  }
};
---


<Layout pageTitle={post.data.title}>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

    <div class="container">

        <Backlink />

        <article class="blog-post">
            <h2 class="blog-post-description">{post.data.description}</h2>
            <p class="blog-post-date">{post.data.date.toLocaleDateString()}</p>

            <div class="blog-post-content" set:html={post.rendered?.html} />

            <CtaRow />
        </article>

    </div>

</Layout>

<style is:global>
  .blog-post-description {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .blog-post-date {
    color: #6c757d;
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }

  .blog-post-content {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .blog-post-content p {
    margin-bottom: 1.5rem;
  }

  .blog-post-content img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
  }
</style>