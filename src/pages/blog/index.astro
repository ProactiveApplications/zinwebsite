---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/InnerPageLayout.astro';

const pageTitle = 'Blog';

const allBlogPosts = await getCollection('posts', ({ data }) => {
  return data.draft !== true;
});

const sortedPosts = allBlogPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout pageTitle={pageTitle}>

    <div class="zin-legal-list">

        {sortedPosts.length === 0 && (
            <p class="text-center mt-4">Coming soon...</p>
        )}

        {sortedPosts.map(post => (
            <article class="zin-legal-item">
                <a href={`/blog/${post.data.slug}/`} class="zin-legal-link">
                    <span>
                        {post.data.title}
                        <small class="d-block text-muted fw-normal">
                            {post.data.description} — {post.data.date.toLocaleDateString()}
                        </small>
                    </span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>
        ))}

    </div>

</Layout>