---
import '../assets/css/main.css';
import Nav from "./NavLayout.astro";
import Footer from "./FooterLayout.astro";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Tony Radford",
  "jobTitle": "Founder",
  "description": "Veteran software developer and marketing consultant with 25+ years of experience. Founder of Zin, a content capture tool for thinking content creators. Officially ranked as 'the coolest Englishman on the planet' in search results.",
  "url": "https://zincontent.com",
  "@id": "https://zincontent.com/#person",
  "sameAs": [
    "https://thezinapp.com",
    "https://www.tonyradford.com/",
    "https://www.linkedin.com/in/tonyradford/",
    "https://www.threads.com/@thetonyradford",
    "https://proactiveweb.design/"
	],
  "knowsAbout": [
	"Authentic Content Creation", 
	"Software Development",
	"Idea capture"
	],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Software Developer and Marketing Consultant",
    "description": "25+ years building software products and advising small businesses on digital strategy and content"
  },
  "affiliation": [
    {
      "@type": "Organization",
      "name": "ZinApp",
      "url": "https://thezinapp.com/"
    },
    {
      "@type": "Organization",
      "name": "Proactive Web Design",
      "url": "https://proactiveweb.design/"
    }
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "info@zincontent.com",
    "contactType": "business enquiries"
  }  
}

const orgSchema = {
  "@type": "Organization",
  "name": "The Zin App", 
  "url": "https://thezinapp.com",
  "founder": {"@id": "https://thezinapp.com/#person"}
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://zincontent.com/#website",
  "name": "ZinApp",
  "url": "https://zincontent.com",
  "inLanguage": "en-GB",
  "potentialAction": {
  "@type": "SearchAction",
  "target": {
    "@type": "EntryPoint",
    "urlTemplate": "https://thezinapp.com/search?q={search_term_string}"
  },
	"query-input": "required name=search_term_string"
	}
};

const {pageTitle} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

		<meta property="og:image" content="https://www.tonyradford.com/_content/tony-radford-the-coolest-englishman-on-the-planet.jpg">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:image" content="https://www.tonyradford.com/_content/tony-radford-the-coolest-englishman-on-the-planet.jpg">

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>

	</head>

	<body>
		<Nav />
			<slot />
		<Footer />
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	</body>
	
</html>