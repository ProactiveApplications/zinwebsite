---
import { getImage } from 'astro:assets';
import logoSrc from '../assets/img/navbar-logo.png';
import CtaBtnSm from '../components/website/cta-btn-sm.astro';

const logo = await getImage({ src: logoSrc, format: 'webp', quality: 90 });
---
<header class="zin-nav navbar navbar-expand-lg">

    <div class="container-fluid px-4">

        <a class="navbar-brand" href="/">
            <img
                src={logo.src}
                alt="Zin"
                class="nav-logo"
                loading="eager"
                decoding="async"
            />
        </a>

        <button
            class="navbar-toggler border-0"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#zinNavMenu"
            aria-controls="zinNavMenu"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="zinNavMenu">
            <ul class="navbar-nav align-items-lg-center gap-lg-3 py-3 py-lg-0">
                <li class="nav-item">
                    <a class="nav-link zin-nav-link" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link zin-nav-link" href="/blog">Blog</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link zin-nav-link" href="/about-tony-radford">About</a>
                </li>
                <li class="nav-item ms-lg-2">
                    <CtaBtnSm subtext="" />
                </li>
            </ul>
        </div>

    </div>
</header>