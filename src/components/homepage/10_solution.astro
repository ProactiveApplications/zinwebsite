---
import { getImage } from 'astro:assets';
import zinInputsSrc from '../../assets/img/zin-inputs.PNG';

const zinInputs = await getImage({ src: zinInputsSrc, format: 'webp', quality: 85 });
---

<section class="sec sec-light">
    
  <div class="container">

    <div class="row">
      <div class="col-12">

        <p>
          <span class="zin-eyebrow">Zin is the perfect store for all your thoughts</span>
        </p>
        <h2 class="zin-h2 zin-h2-sm mb-3">
          Capture your thoughts. Mine your content. Add it all to Zin. 
        </h2>

      </div>
    </div>

    <div class="row align-items-center">

      <div class="col-md-6">
        <img
          src={zinInputs.src}
          alt="Zin — two sources of input, one searchable library"
          class="solution-img"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="col-md-6">
        
        <p class="zin-body">
          Capture your thoughts in seconds at your desk or on your phone. 
        </p>

        <p class="zin-body mb-3">
          Harvest your ideas from your past writing. The value you once created becomes available to you again.
        </p>

        <p class="zin-body">
          And once a thought is in Zin, your mind can let it go and you naturally feel relief.
        </p>
 
      </div>

    </div>
  </div>

</section>