---
import { getImage } from 'astro:assets';
import zinInputsSrc from '../../../src/assets/img/zin-inputs-3x.png';

const zinInputs = await getImage({ src: zinInputsSrc, format: 'webp', quality: 85 });
---

  <!-- ============================================================
       SOLUTION
  ============================================================ -->
  <section class="sec sec-light">
    <div class="container">
      <div class="row align-items-center g-5">

        <div class="col-lg-6">
          <span class="zin-eyebrow">The mechanism</span>
          <h2 class="zin-h2 zin-h2-sm mb-3">Your past writing and present thinking are your best raw material. Zin makes them usable.</h2>
          <p class="zin-body mb-3">Most people have years of good thinking in old posts, emails and notebooks. Inaccessible. Unsearchable. Slowly forgotten.</p>
          <p class="zin-body">Zin surfaces what you've already thought — and catches what's arriving right now. One library. Both directions. Ready when you need it.</p>
        </div>

        <div class="col-lg-6">
          <img
            src={zinInputs.src}
            alt="Zin — two sources of input, one searchable library"
            class="solution-img"
            loading="lazy"
            decoding="async"
          />
        </div>

      </div>
    </div>
  </section>