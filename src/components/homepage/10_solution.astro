---
import { getImage } from 'astro:assets';
import zinInputsSrc from '../../../src/assets/img/zin-inputs.PNG';

const zinInputs = await getImage({ src: zinInputsSrc, format: 'webp', quality: 85 });
---

<section class="sec sec-light">
    
  <div class="container">

    <div class="row align-items-center g-5">

      <div class="col-md-6">
        
        <span class="zin-eyebrow">Gather your thinking</span>
        
        <h2 class="zin-h2 zin-h2-sm mb-3">
          Your past writing and present thinking are unique raw material. Zin makes them usable.
        </h2>
        
        <p class="zin-body mb-3">
          Most people have years of great ideas and their best thinking locked-up in old posts, emails, notebooks. This content is a gold mine for your thinking and a valueable asset if you write content.
        </p>
        <p class="zin-body">
        Use Zin to harvest ideas from your old content, organise them and store them safely.
        </p>
      </div>

      <div class="col-md-6">
        <img
          src={zinInputs.src}
          alt="Zin — two sources of input, one searchable library"
          class="solution-img"
          loading="lazy"
          decoding="async"
        />
      </div>

    </div>
  </div>

</section>