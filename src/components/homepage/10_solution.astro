---
import { getImage } from 'astro:assets';
import zinInputsSrc from '../../../src/assets/img/zin-inputs.PNG';

const zinInputs = await getImage({ src: zinInputsSrc, format: 'webp', quality: 85 });
---

<section class="sec sec-light">
    
  <div class="container">

    <div class="row align-items-center g-5">

      <div class="col-md-6">
        <img
          src={zinInputs.src}
          alt="Zin — two sources of input, one searchable library"
          class="solution-img"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="col-md-6">
        
        <span class="zin-eyebrow">Zin does the remembering. Your mind does the thinking.</span>
        
        <h2 class="zin-h2 zin-h2-sm mb-3">
          One place to keep your thoughts. Two types of input.
        </h2>
        
        <p class="zin-body mb-3">
          Zin enables you to harvest your ideas from your past writing. The value you already created comes back within reach.
        </p>

        <p class="zin-body">
          New thinking is caught in seconds at your desk or on your phone. 
        </p>

        <p class="zin-body">
          And once a thought is in Zin, your mind can let it go and you naturally feel relief.
        </p>
 
      </div>

    </div>
  </div>

</section>