---
import { getImage } from 'astro:assets';
import zinImage1 from '../../assets/img/zin1.PNG';

const zinInputs = await getImage({ src: zinImage1, format: 'webp', quality: 85 });
---

<section class="sec sec-canvas">

  <div class="container">

    <div class="row mb-3">
      <span class="zin-eyebrow">Your library of thinking</span>
      <h2 class="zin-h2">Build content or develops ideas fast</h2>
      <p class="zin-body">
          Use Zin's simple and very effective filters to quickly find related ideas, by topic, hashtags and date. 
      </p>
      <!-- <p class="zin-body">
        Zin filters at the level of the individual thought. A topic, a hashtag, free text, a date range. Results return exactly what you are looking for, not the whole document it sat inside. Filter by date range to see what you were thinking at any given time.
      </p> -->
    </div>

    <div class="row">
      <div class="col-12">
        <img
          src={zinImage1.src}
          alt="Zin — filter and browse your library of thinking"
          class="solution-img border"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

  </div>

</section>