---
import { getImage } from 'astro:assets';
import libraryImage from '../../../src/assets/img/pexels-mehmetakifarts-37330363.webp';

const zinInputs = await getImage({ src: libraryImage, format: 'webp', quality: 85 });
---
<!-- ============================================================
       WHY A LIBRARY — NOT JUST NOTES
  ============================================================ -->
<section class="sec sec-tint" id="why-need-library">
  <div class="container sec-white p-4 rounded-3 shadow">

    <div class="row mb-4">
      <div class="col-12">

        <p>
          <span class="zin-eyebrow">Build your library of thinking</span>
        </p>
        <h2 class="zin-h2 zin-h2-sm mb-3">
          Every thought you add to Zin enhances <em>all</em> your thinking
        </h2>

      </div>
    </div>

    <div class="row">
      <div class="col-12 col-md-4">

        <img
          src={libraryImage.src}
          alt="Zin — why a library - libraries compound"
          class="solution-img mb-4"
          loading="lazy"
          decoding="async"
        />

      </div>
      <div class="col-md-8 ps-2">

        <p class="zin-body mb-4">
          <b>Notes stored in Zin are raw material</b> 
          <br />
          Pick a topic and your notes are ready to be built into more thinking or content.
        </p>

        <p class="zin-body mb-4">
          <b>Unload your thoughts into Zin</b> 
          <br />
          Feel relief. Gain space for more thinking.
        </p>

        <p class="zin-body mb-0">
          <b>The library keeps everything together</b> 
          <br />
          Four hundred thoughts in one place beats four hundred notes scattered across four apps. 
        </p>

        <hr class="divider" />

        <p class="fs-2 mb-3">Six months from now, you'll still be losing your best ideas.</p>

        <p class="zin-body mb-2">
          The library you <em>could</em> have built will not exist. The thinking you could have done will not have happened.
        </p>
        
        <p class="fs-2 mb-3">Build your library of thinking now.</p>

      </div>
      
    </div>

  </div>
</section>