<section class="sec sec-light" id="ai-tools-comparison">
  <div class="container">

    <div class="row mb-4">
      <div class="col-12">
        <span class="zin-eyebrow">You and AI</span>
        <h2 class="zin-h2">Everyone has the same AI. The difference is what you feed it.</h2>
      </div>
    </div>

    <div class="row g-4">

      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
