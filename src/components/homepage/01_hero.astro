---
import CtaBtn from '../website/cta-btn.astro';
---
<section id="hero">
    <div class="container-fluid bg-gradient-primary pt-5 pb-5 bg-light-teal">
        <div class="container pt-2 pb-5 border-default rounded-2 shadow-medium bg-light">

            <div class="grid">

                <div class="col-mobile-12 col-12 pl-2 pt-4 text-center">
                    <p>
                        <i class="bi bi-star-fill txt-orange mr-2"></i> 
                        For consultants, coaches and experts building their reputation on LinkedIn
                        <i class="bi bi-star-fill txt-orange ml-2"></i> 
                    </p>
                    <h1>The LinkedIn Algorithm Change Is Burying AI Content. Is Yours Next?</h1>

                </div>
            </div>

            <div class="grid">
                <div class="col-mobile-12 col-6 pb-0 pl-2">                
                
                    <p>
                        Zin helps you create LinkedIn content rooted in your real expertise and lived experience. This is the kind of content that LinkedIn loves.
                    </p>
                    <ul class="no-bullets">
                        <li class="mb-3"><i class="bi bi-check-lg txt-orange mr-2"></i>
                            Capture your best thinking before it disappears
                        </li>
                        <li class="mb-3"><i class="bi bi-check-lg txt-orange mr-2"></i>
                            Build a library of your own ideas, stories and insights
                        </li>
                        <li class="mb-3"><i class="bi bi-check-lg txt-orange mr-2"></i>
                            Generate authentic content that sounds like you, not like everyone else's AI
                        </li>
                    </ul>

                    <CtaBtn subtext="The 360Brew algorithm update rewards authentic, niche-specific human voices. Zin is built for exactly that." />
                    
                </div>

                <div class="col-mobile-12 col-6 img-vcenter-grid">
                    <img src="https://xo8h-rjxb-rsw5.e2.xano.io/vault/tGsoI1Ml/i0LLIKu7MYJhtu9to72_x75CxJo/U6sC0w../brooke-cagle-JBwcenOuRCg-unsplash-lg.webp"
                    class="img-responsive-rounded img-fill" alt="Hero Image woman smiling and working on laptop"
                    />
                </div>
            </div>
            
        </div>
    </div>
</section>