---
import { getImage } from 'astro:assets';
import heroSrc from '../../../src/assets/img/zin-hero-female.jpg';

const heroImg = await getImage({ src: heroSrc, format: 'webp', quality: 85 });
---

  <!-- ============================================================
       HERO — full bleed background image
  ============================================================ -->
  <section
    class="hero-fullbleed"
    style={`background-image: url('${heroImg.src}')`}
    id="hero"
  >
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <h1 class="zin-h1 zin-h1-hero mb-4">Zin helps people with ideas and scattered content finally get organised.</h1>
        <p class="hero-sub-copy mb-4">Bring everything into Zin. Save the content you've already written. Capture good ideas before you lose them. Experience relief because everything is now easily findable and ready to use whenever you need it.</p>
        <a href="https://thezinapp.com/register/" class="btn-zin">Try Zin free for 14 days</a>
        <span class="zin-muted-text d-block mt-2">No commitment. Cancel anytime.</span>
      </div>
    </div>
  </section>