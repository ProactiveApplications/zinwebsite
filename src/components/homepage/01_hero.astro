---
import placeholderImg from '../../../src/assets/img/placeholder.webp';
---

  <!-- ============================================================
       HERO
  ============================================================ -->
  <section class="sec sec-white" id="hero">
    <div class="container">
      <div class="row align-items-center g-5">

        <div class="col-lg-6">
          <span class="zin-eyebrow">Ever lost a great idea before you could use it?</span>
          <h1 class="zin-h1 zin-h1-hero mb-3">Your best ideas disappear before you can <em>use</em> them.</h1>
          <p class="zin-body mb-4">Zin captures your thinking, builds it into a searchable library, and gives AI something real to work with.</p>
          <ul class="zin-bullets">
            <li>
              <span class="zin-tick">
                <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 5l2 2 4-4" stroke="#fd7e15" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              Capture a thought in seconds, wherever you are
            </li>
            <li>
              <span class="zin-tick">
                <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 5l2 2 4-4" stroke="#fd7e15" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              Build a private library from your past and present thinking
            </li>
            <li>
              <span class="zin-tick">
                <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 5l2 2 4-4" stroke="#fd7e15" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              Create content that sounds like you — not like everyone else's AI
            </li>
          </ul>
          <a href="https://thezinapp.com/register/" class="btn-zin">Try Zin free for 14 days</a>
          <span class="zin-muted-text d-block mt-2">No commitment. Cancel anytime.</span>
        </div>

        <div class="col-lg-6 mockup-wrap">
          <img
            src={placeholderImg.src}
            alt="Zin app interface showing captured thoughts"
            class="mockup-img"
          />
        </div>

      </div>
    </div>
  </section>