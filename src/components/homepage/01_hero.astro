---
import { getImage } from 'astro:assets';
import heroSrc from '../../../src/assets/img/zin-hero-female.jpg';

const heroImg = await getImage({ src: heroSrc, format: 'webp', quality: 85 });
---

  <!-- ============================================================
       HERO — full bleed background image
  ============================================================ -->
  <section
    class="hero-fullbleed"
    style={`background-image: url('${heroImg.src}')`}
    id="hero"
  >
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <span class="zin-eyebrow zin-eyebrow-light">Ever lost a great idea before you could use it?</span>
        <h1 class="zin-h1 zin-h1-hero mb-4">Your best ideas disappear before you can <em>use</em> them.</h1>
        <p class="hero-sub-copy mb-4">Your expertise is not the problem. The insight from that client call, the phrase that arrived on your walk — gone before you could use it. Zin captures your thinking and gives AI something real to work with.</p>
        <a href="https://thezinapp.com/register/" class="btn-zin">Try Zin free for 14 days</a>
        <span class="hero-micro d-block mt-2">No commitment. Cancel anytime.</span>
      </div>
    </div>
  </section>