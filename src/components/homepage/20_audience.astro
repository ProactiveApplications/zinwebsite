---
import { getImage } from 'astro:assets';
import audienceImage from '../../../src/assets/img/pexels-karola-g-5908758.webp';

const zinInputs = await getImage({ src: audienceImage, format: 'webp', quality: 85 });
---
  <section class="sec sec-light">
    <div class="container">

      <div class="row">
        <div class="col-md-8 pe-1">
          <span class="zin-eyebrow">Who Zin is for</span>
          <h2 class="zin-h2 mb-4">For people who want more from their own thinking.</h2>

          <p class="zin-body mb-4"><i class="bi bi-check orange-text me-2"></i>
            <b>You create written content</b>
            <br />
            New ideas or old ideas become available to you, just when you need theme.
          </p>

        <p class="zin-body mb-4"><i class="bi bi-check orange-text me-2"></i>
          <b>You are a reader</b>
          <br />
          Capture your thoughts. Review them at any time, for any book.
        </p>

        <p class="zin-body mb-4"><i class="bi bi-check orange-text me-2"></i>
            <b>You keep a journal </b>
            <br />
            Review journal entries by theme or date. Or simply scroll through your entries.
        </p>

      </div>

      <div class="col-12 col-md-4">

         <img
          src={audienceImage.src}
          alt="Zin — lack of capture is the problem"
          class="solution-img mt-4"
          loading="lazy"
          decoding="async"
        />

      </div>
      </div>

    </div>
  </section>