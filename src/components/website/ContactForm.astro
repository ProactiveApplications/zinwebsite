---
// ContactForm.astro
---

<div class="contact-fluid bg-light-teal pt-5 pb-5 pr-2 pl-2 border-default">

<div class="contact-form-container">
  <form id="contactForm" novalidate>
    <div class="hp-wrapper" aria-hidden="true">
      <label for="middle_name">Middle Name</label>
      <input type="text" id="middle_name" name="middle_name" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-group mb-3">
      <label for="email" class="form-label">Email address <span class="txt-danger">*</span></label>
      <input 
        type="email" 
        class="form-control" 
        id="email" 
        name="email" 
        required
        placeholder="your.email@example.com"
      />
    </div>

    <div class="form-group mb-3">
      <label for="name" class="form-label">Name</label>
      <input type="text" class="form-control" id="name" name="name" placeholder="Your name" />
    </div>

    <div class="form-group mb-3">
      <label for="message" class="form-label">Message</label>
      <textarea class="form-control" id="message" name="message" rows="4" placeholder="Tell us about your interest..."></textarea>
    </div>

    <div class="form-group mb-3">
      <div class="d-flex align-start gap-2">
        <input type="checkbox" id="gdprConsent" name="gdprConsent" required style="margin-top: 6px;" />
        <label for="gdprConsent" class="text-sm">
          I agree to the <a href="https://zincontent.com/legals/privacy-and-cookies/" target="_blank">Privacy Policy</a> and consent to the processing of my data <span class="txt-danger">*</span>
        </label>
      </div>
    </div>

    <button type="submit" class="btn btn-primary" id="submitBtn">
      <span class="btn-text">Register Interest</span>
    </button>

    <div id="formStatus" class="mt-3"></div>
  </form>
</div>

</div>



<style>
  .contact-form-container {
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
  }

  .hp-wrapper {
    display: none !important;
    visibility: hidden !important;
  }
</style>

<script>
  // Page load time for security
  const formLoadTime = Date.now();

  // We wrap everything in a function to ensure the DOM is scoped correctly
  const initForm = () => {
    const form = document.getElementById('contactForm') as HTMLFormElement;
    if (!form) return;

    const submitBtn = form.querySelector('#submitBtn') as HTMLButtonElement;
    const btnText = submitBtn?.querySelector('.btn-text') as HTMLSpanElement;
    const formStatus = form.querySelector('#formStatus') as HTMLDivElement;

    function showAlert(message, type) {
      const alertClass = type === 'success' ? 'alert-success txt-success' : 'alert-danger txt-danger';
      formStatus.innerHTML = `
        <div class="alert ${alertClass}">
          <span>${message}</span>
          <button type="button" class="close-btn" aria-label="Close">&times;</button>
        </div>
      `;

      formStatus.querySelector('.close-btn')?.addEventListener('click', () => {
        formStatus.innerHTML = '';
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Select inputs specifically from THIS form instance
      const emailInput = form.querySelector('#email') as HTMLInputElement;
      const gdprInput = form.querySelector('#gdprConsent') as HTMLInputElement;
      const hpInput = form.querySelector('#middle_name') as HTMLInputElement;
      const nameInput = form.querySelector('#name') as HTMLInputElement;
      const messageInput = form.querySelector('#message') as HTMLTextAreaElement;
      
      formStatus.innerHTML = '';

      // 1. Validation Logic with safe checks
      let errorParts = [];
      const emailValue = emailInput?.value?.trim() || '';
      
      if (!emailValue || !emailInput.checkValidity()) {
        errorParts.push("add a valid email address");
      }
      if (!gdprInput?.checked) {
        errorParts.push("click the checkbox to show you agree with the Privacy Policy");
      }

      if (errorParts.length > 0) {
        showAlert(`Please ${errorParts.join(" and ")}.`, 'danger');
        return;
      }

      // 2. Submit State
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Sending...';

      // 3. Build Payload safely
      const payload = {
        email: emailValue,
        name: nameInput?.value?.trim() || '',
        message: messageInput?.value?.trim() || '',
        gdprConsent: gdprInput.checked,
        middle_name: hpInput?.value || '',
        form_loaded_at: formLoadTime
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          showAlert('<strong>Success!</strong> Your interest is registered. Please check your email.', 'success');
          form.reset();
        } else {
          const result = await response.json();
          throw new Error(result.error || 'Submission failed');
        }
      } catch (error) {
        showAlert(`<strong>Error:</strong> ${error instanceof Error ? error.message : 'Something went wrong.'}`, 'danger');
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Register Interest';
      }
    });
  };

  // Initialize on load
  initForm();
</script>