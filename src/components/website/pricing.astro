---
 import CtaBtn from './cta-btn.astro';
---
<section>
    <div class="container-fluid mb-5">
        <div class="container" id="email">

            <div class="grid">
                <div class="col-mobile-12 col-12 text-center">
                    <div class="col-12 col-mobile-12 pt-5 pb-5">

                        <h1>Pricing</h1>
                        <h2 class="txt-dark">Just £9.97 per month</h2>

                        <p>
                            One pricing for a tool that does one job extremely well.
                        </p>

                        <p>
                            If you are creating social media content, you're creating content worth far more than £9.97.  ZinApp will provide inspiration, a starting point, an outline, all from real material you've already captured.
                        </p>

                        <p>
                            With ZinApp, you never need to sit down to write without something genuine to work with. 
                        </p>
                        <p>
                            You can cancel at anytime.
                        </p>

                        <p>
                            <i class="bi bi-star-fill txt-orange mr-2"></i> 
                            If you would like to generate authentic, stand-out content, click the button below.
                            <i class="bi bi-star-fill txt-orange mr-2"></i> 
                        </p>

                        <CtaBtn subtext="In an age of AI, authenticity is a strategic advantage. Be authentic with Zin App." />
                        
                    </div>
                </div>  
            </div>
           

        </div>
    </div>
</section>

