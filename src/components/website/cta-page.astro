---
import ContactForm from '../../components/website/ContactForm.astro';
---
<section>
    <div class="container-fluid mb-5">
        <div class="container" id="email">

            <div class="grid">
                <div class="col-mobile-12 col-12 text-center">
                    <h2>Get Early Access to ZinApp</h2>
                    <h4>Join the waitlist and be the first to know when ZinApp is available.</h4>
                    <p>
                        When we go live, access to ZinApp will cost £9.97 per month. 
                        <br />
                        <a href="/pricing">Read more about our pricing here</a>
                    </p>
                </div>  
            </div>
            <div class="grid">

                    <div class="col-mobile-12 col-12 text-center">
                        <h3>
                            Use the form below to sign-up for early access.
                        </h3>
                        <p>
                            Add your name, email and an optional message in the form below.
                        </p>
                        <p class="txt-orange">
                            We promise to only contact you regarding the ZinApp.
                        </p>

                        
                    </div>  

                    <div class="col-mobile-12 col-12">
                        <ContactForm />
                    </div>
            </div>
            


        </div>
    </div>
</section>

<!-- Back to top -->
<section>
    <div class="container-fluid mt-5 mb-5">
        <div class="container">
            <a href="#hero">
                <i class="bi bi-box-arrow-up txt-orange" style="font-size: 2rem;"></i>
            </a>
        </div>
    </div>
    </section>