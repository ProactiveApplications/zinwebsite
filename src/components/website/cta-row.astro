---
// cta-row.astro
import CtaBtn from '../website/cta-btn.astro';

const { 
    heading = "The perfect time to start is now.",
    subtext = "No commitment. Cancel anytime."
} = Astro.props;
---
<section class="sec sec-dark">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 text-center">
                <p class="zin-body-white mb-4">{heading}</p>
                <CtaBtn subtext={subtext} />
            </div>
        </div>
    </div>
</section>